# Banco PostgreSQL local (scripts/banco_local.ps1 ou docker-compose.yml na raiz)
DATABASE_URL=postgresql://postgres@localhost:5433/ajuvet

# Segredo para assinar os tokens de login. Gere um com:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
FUSO_HORARIO=America/Maceio

# Clínica (aparece no fim das mensagens ao tutor)
NOME_CLINICA=AjuVet+ Clínica Veterinária
CONTATO_CLINICA=

# Notificações ao tutor. Sem SMTP_HOST, os e-mails viram arquivos .eml em backend/.arquivos/emails
ENVIO_AUTOMATICO_NOTIFICACOES=true
INTERVALO_ENVIO_SEGUNDOS=60
EMAIL_REMETENTE=AjuVet+ <nao-responda@ajuvet.local>
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_TLS=true
