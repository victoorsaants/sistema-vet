# Configuração do docker compose. Copie para .env (na raiz) e ajuste.

# Obrigatório. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=

# Senha do PostgreSQL do container
POSTGRES_PASSWORD=ajuvet

# true carrega os usuários e dados de exemplo na primeira subida (banco vazio)
CARREGAR_DADOS_EXEMPLO=true

# Portas no computador
PORTA_FRONTEND=3000
PORTA_BACKEND=8000
PORTA_BANCO=5433

# Endereço em que o sistema é aberto no navegador
URL_FRONTEND=http://localhost:3000

# true só quando o sistema estiver atrás de HTTPS
COOKIE_SEGURO=false

FUSO_HORARIO=America/Maceio
NOME_CLINICA=AjuVet+ Clínica Veterinária
CONTATO_CLINICA=

# E-mails ao tutor. Sem SMTP_HOST, ficam como arquivos .eml no volume arquivos_ajuvet
EMAIL_REMETENTE=AjuVet+ <nao-responda@ajuvet.local>
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_TLS=true
